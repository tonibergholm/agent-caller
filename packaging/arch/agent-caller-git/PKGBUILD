# Maintainer: Toni Bergholm
#
# acd, the agent-caller daemon, built from the main branch (a -git package).
# Release steps and testing: docs/packaging.md.
#
# The source is a git checkout of main, which contains packaging/ and the tests
# check() runs; the v0.9.0 tag does not. pkgver() records the commit built.
# To build one exact commit, append #commit=<sha> instead of #branch=main.
# The release-tag package is ../agent-caller. Docs: docs/packaging.md.
pkgname=agent-caller-git
pkgver=0.9.0.r0.g0000000 # placeholder: pkgver() sets the real value
pkgrel=1
pkgdesc='Inbox daemon (acd) for coding-agent permission requests and questions (git)'
arch=(x86_64 aarch64)
url='https://github.com/tonibergholm/agent-caller'
license=(MIT)
depends=(glibc gcc-libs)
makedepends=(cargo git)
provides=(agent-caller)
conflicts=(agent-caller)
# makepkg's default LTO flags break linking the C and assembly objects that
# ring builds (undefined ring_core_* symbols). Tested in a container.
options=(!lto)
source=("$pkgname::git+$url.git#branch=main")
sha256sums=(SKIP)

pkgver() {
  cd "$pkgname" || return 1
  # 0.9.0.r12.gabc1234: the last v* tag, commits since it, the commit.
  git describe --long --tags --match 'v[0-9]*' | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd "$pkgname" || return 1
  export RUSTUP_TOOLCHAIN=stable
  # --locked: Cargo.lock decides every version. Nothing is resolved here.
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname" || return 1
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # Keep the build directory and the cargo registry out of the binary, so the
  # same tag gives the same bytes wherever it is built.
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$PWD=/build/$pkgname --remap-path-prefix=${CARGO_HOME:-$HOME/.cargo}=/cargo"
  cargo build --frozen --release -p acd
}

check() {
  cd "$pkgname" || return 1
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$PWD=/build/$pkgname --remap-path-prefix=${CARGO_HOME:-$HOME/.cargo}=/cargo"
  # The packaged unit must still be what `acd service install` writes. The
  # whole suite runs in CI; some of it needs a real session.
  cargo test --frozen --release -p acd --test packaging_unit
}

package() {
  cd "$pkgname" || return 1
  install -Dm755 target/release/acd "$pkgdir/usr/bin/acd"
  # A copy in ~/.config/systemd/user (from `acd service install`) wins over
  # this one, so both can exist.
  install -Dm644 packaging/systemd/acd.service "$pkgdir/usr/lib/systemd/user/acd.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  # No shell completions: the CLI has no completion generator yet. No
  # backup=() entries: the package owns no file under /etc or in a home.
}
