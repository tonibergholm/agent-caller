{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Caller",
  "version": "0.1.0",
  "identifier": "dev.agentcaller.inbox.ios",
  "build": {
    "frontendDist": "../../../app/dist",
    "beforeBuildCommand": "npm --prefix ../../app run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agent Caller"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png"]
  }
}
