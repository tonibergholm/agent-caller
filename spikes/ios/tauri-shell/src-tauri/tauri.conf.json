{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Caller Spike",
  "version": "0.0.1",
  "identifier": "dev.agentcaller.inbox.iosspike",
  "build": {
    "frontendDist": "../../../../app/dist",
    "beforeBuildCommand": "npm --prefix ../../../app run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agent Caller",
        "width": 400,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
