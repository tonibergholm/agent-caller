{
  "$defs": {
    "Agent": {
      "properties": {
        "can_send": {
          "type": "boolean"
        },
        "cwd": {
          "type": [
            "string",
            "null"
          ]
        },
        "failed": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AgentKind"
        },
        "last_message": {
          "type": [
            "string",
            "null"
          ]
        },
        "machine_id": {
          "type": "string"
        },
        "pending": {
          "anyOf": [
            {
              "$ref": "#/$defs/Request"
            },
            {
              "type": "null"
            }
          ]
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "state": {
          "$ref": "#/$defs/AgentState"
        },
        "state_since": {
          "format": "date-time",
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "machine_id",
        "source",
        "kind",
        "title",
        "state",
        "state_since",
        "failed",
        "can_send"
      ],
      "type": "object"
    },
    "AgentKind": {
      "enum": [
        "claude",
        "codex",
        "other",
        "unknown"
      ],
      "type": "string"
    },
    "AgentState": {
      "enum": [
        "working",
        "needs_you",
        "done",
        "idle",
        "unknown"
      ],
      "type": "string"
    },
    "AnswerPath": {
      "enum": [
        "hook",
        "keys",
        "t3",
        "none",
        "unknown"
      ],
      "type": "string"
    },
    "CommandResult": {
      "properties": {
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorBody"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/Outcome"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "ok"
      ],
      "type": "object"
    },
    "Effect": {
      "enum": [
        "allow",
        "allow_always",
        "deny",
        "choose",
        "unknown"
      ],
      "type": "string"
    },
    "ErrorBody": {
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "ErrorCode": {
      "oneOf": [
        {
          "enum": [
            "request_gone",
            "request_changed",
            "request_busy",
            "request_not_ready",
            "not_answerable",
            "agent_gone",
            "agent_busy",
            "not_supported",
            "screen_mismatch",
            "bad_request",
            "duplicate_mismatch",
            "source_unavailable",
            "unauthorized",
            "unsupported_protocol"
          ],
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "A code this version does not know (spec §7.2: tolerate unknown input).",
          "type": "string"
        }
      ]
    },
    "Machine": {
      "properties": {
        "acd_version": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "sources": {
          "$ref": "#/$defs/Sources"
        }
      },
      "required": [
        "id",
        "name",
        "acd_version",
        "sources"
      ],
      "type": "object"
    },
    "Outcome": {
      "enum": [
        "delivered"
      ],
      "type": "string"
    },
    "Question": {
      "properties": {
        "header": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "multi_select": {
          "type": "boolean"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/RequestOption"
          },
          "type": "array"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "multi_select",
        "options"
      ],
      "type": "object"
    },
    "Request": {
      "properties": {
        "agent_id": {
          "type": "string"
        },
        "answer_path": {
          "$ref": "#/$defs/AnswerPath"
        },
        "detail": {
          "type": "string"
        },
        "free_text": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RequestKind"
        },
        "opened_at": {
          "format": "date-time",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/RequestOption"
          },
          "type": "array"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/Question"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "raw_screen": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "default": 0,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/RequestStatus"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "agent_id",
        "kind",
        "status",
        "answer_path",
        "title",
        "detail",
        "options",
        "free_text",
        "opened_at"
      ],
      "type": "object"
    },
    "RequestKind": {
      "enum": [
        "permission",
        "question",
        "blocked_unparsed",
        "unknown"
      ],
      "type": "string"
    },
    "RequestOption": {
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "effect": {
          "$ref": "#/$defs/Effect"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "effect"
      ],
      "type": "object"
    },
    "RequestStatus": {
      "enum": [
        "open",
        "answering",
        "resolved",
        "unknown"
      ],
      "type": "string"
    },
    "ResolvedBy": {
      "enum": [
        "inbox",
        "terminal",
        "agent",
        "superseded",
        "uncertain",
        "lost",
        "unknown"
      ],
      "type": "string"
    },
    "Source": {
      "enum": [
        "herdr",
        "t3",
        "hooks",
        "unknown"
      ],
      "type": "string"
    },
    "SourceState": {
      "enum": [
        "ok",
        "degraded",
        "disabled",
        "unconfigured",
        "unknown"
      ],
      "type": "string"
    },
    "SourceStatus": {
      "properties": {
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/SourceState"
        }
      },
      "required": [
        "state"
      ],
      "type": "object"
    },
    "Sources": {
      "properties": {
        "herdr": {
          "$ref": "#/$defs/SourceStatus"
        },
        "hooks": {
          "$ref": "#/$defs/SourceStatus"
        },
        "t3": {
          "$ref": "#/$defs/SourceStatus"
        }
      },
      "required": [
        "hooks",
        "herdr",
        "t3"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "properties": {
        "capabilities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "epoch": {
          "type": "string"
        },
        "machine": {
          "$ref": "#/$defs/Machine"
        },
        "seq": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "welcome",
          "type": "string"
        }
      },
      "required": [
        "type",
        "machine",
        "capabilities",
        "epoch",
        "seq"
      ],
      "type": "object"
    },
    {
      "properties": {
        "agents": {
          "items": {
            "$ref": "#/$defs/Agent"
          },
          "type": "array"
        },
        "epoch": {
          "type": "string"
        },
        "seq": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "snapshot",
          "type": "string"
        }
      },
      "required": [
        "type",
        "epoch",
        "seq",
        "agents"
      ],
      "type": "object"
    },
    {
      "properties": {
        "agent": {
          "$ref": "#/$defs/Agent"
        },
        "epoch": {
          "type": "string"
        },
        "seq": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "agent.updated",
          "type": "string"
        }
      },
      "required": [
        "type",
        "epoch",
        "seq",
        "agent"
      ],
      "type": "object"
    },
    {
      "properties": {
        "agent_id": {
          "type": "string"
        },
        "epoch": {
          "type": "string"
        },
        "seq": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "agent.removed",
          "type": "string"
        }
      },
      "required": [
        "type",
        "epoch",
        "seq",
        "agent_id"
      ],
      "type": "object"
    },
    {
      "properties": {
        "epoch": {
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/Request"
        },
        "seq": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "request.opened",
          "type": "string"
        }
      },
      "required": [
        "type",
        "epoch",
        "seq",
        "request"
      ],
      "type": "object"
    },
    {
      "properties": {
        "agent_id": {
          "type": "string"
        },
        "by": {
          "$ref": "#/$defs/ResolvedBy"
        },
        "epoch": {
          "type": "string"
        },
        "option_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "request_id": {
          "type": "string"
        },
        "seq": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "request.resolved",
          "type": "string"
        }
      },
      "required": [
        "type",
        "epoch",
        "seq",
        "request_id",
        "agent_id",
        "by"
      ],
      "type": "object"
    },
    {
      "properties": {
        "epoch": {
          "type": "string"
        },
        "machine": {
          "$ref": "#/$defs/Machine"
        },
        "seq": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "machine.updated",
          "type": "string"
        }
      },
      "required": [
        "type",
        "epoch",
        "seq",
        "machine"
      ],
      "type": "object"
    },
    {
      "$ref": "#/$defs/CommandResult",
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "error": {
                  "type": "null"
                },
                "ok": {
                  "const": true
                }
              }
            },
            {
              "properties": {
                "error": {
                  "type": "object"
                },
                "ok": {
                  "const": false
                },
                "outcome": {
                  "type": "null"
                }
              },
              "required": [
                "error"
              ]
            }
          ]
        }
      ],
      "properties": {
        "type": {
          "const": "result",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    {
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "pong",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "type": "object"
    },
    {
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        },
        "supported": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "type": {
          "const": "error",
          "type": "string"
        }
      },
      "required": [
        "type",
        "code",
        "message"
      ],
      "type": "object"
    }
  ],
  "title": "ServerMessage"
}
