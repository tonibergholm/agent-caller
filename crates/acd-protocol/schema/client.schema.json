{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientMessage",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "client": {
          "$ref": "#/$defs/ClientInfo"
        },
        "protocol": {
          "type": "string"
        },
        "resume": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cursor"
            },
            {
              "type": "null"
            }
          ]
        },
        "token": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "hello"
        }
      },
      "required": [
        "type",
        "protocol",
        "token",
        "client"
      ]
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "option_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "request_id": {
          "type": "string"
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": "string",
          "const": "request.answer"
        }
      },
      "required": [
        "type",
        "id",
        "request_id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "agent_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "agent.send"
        }
      },
      "required": [
        "type",
        "id",
        "agent_id",
        "text"
      ]
    },
    {
      "type": "object",
      "properties": {
        "agent_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "agent.mark_seen"
        }
      },
      "required": [
        "type",
        "id",
        "agent_id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "ping"
        }
      },
      "required": [
        "type",
        "id"
      ]
    }
  ],
  "$defs": {
    "ClientInfo": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "version"
      ]
    },
    "Cursor": {
      "type": "object",
      "properties": {
        "epoch": {
          "type": "string"
        },
        "seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "epoch",
        "seq"
      ]
    }
  }
}
